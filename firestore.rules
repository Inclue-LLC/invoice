rules_version = '2';

// 社内ドメインのユーザーと、「ユーザー管理」で招待された Google アカウントのみアクセスを許可します。
// ドメインを変更する場合は isDomainUser() の正規表現と .env の VITE_ALLOWED_DOMAIN を合わせて変更してください。
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email is string;
    }

    function isDomainUser() {
      return signedIn() && request.auth.token.email.lower().matches('.*@inclue-llc[.]jp$');
    }

    function isInvitedUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/members/$(request.auth.token.email.lower()));
    }

    function isMember() {
      return isDomainUser() || isInvitedUser();
    }

    function validDocument(d) {
      return d.type in ['invoice', 'purchase_order', 'delivery_note', 'receipt']
        && d.status in ['draft', 'issued', 'paid', 'cancelled']
        && d.number is string && d.number.size() <= 64
        && d.items is list && d.items.size() <= 200;
    }

    // 帳票
    match /documents/{docId} {
      allow read, delete: if isMember();
      allow create: if isMember() && validDocument(request.resource.data)
        && request.resource.data.createdBy == request.auth.token.email;
      allow update: if isMember() && validDocument(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy;
    }

    // 取引先マスタ
    match /clients/{clientId} {
      allow read, write: if isMember();
    }

    // 自社情報などの設定
    match /settings/{settingId} {
      allow read, write: if isMember();
    }

    // 招待ユーザー（ドキュメントID = メールアドレス小文字）。追加・削除は社内ドメインのユーザーのみ
    match /members/{email} {
      allow read: if isDomainUser() || (signedIn() && request.auth.token.email.lower() == email);
      allow create, update: if isDomainUser() && request.resource.data.email == email;
      allow delete: if isDomainUser();
    }

    // 採番カウンタ（値は単調増加のみ許可）
    match /counters/{counterId} {
      allow read: if isMember();
      allow create: if isMember() && request.resource.data.seq is int;
      allow update: if isMember() && request.resource.data.seq is int
        && request.resource.data.seq > resource.data.seq;
    }
  }
}
